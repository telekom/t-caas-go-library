{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["custom.regex", "gomod"],
  "automerge": false,
  "dependencyDashboard": true,
  "prConcurrentLimit": 5,
  "labels": ["dependencies"],
  "postUpdateOptions": ["gomodTidyAll"],
  "packageRules": [
    {
      "description": "Dependabot owns ordinary Go module updates",
      "matchManagers": ["gomod"],
      "enabled": false
    },
    {
      "description": "Keep the supported Go compiler line patched using native module artifact updates",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "enabled": true,
      "rangeStrategy": "bump",
      "allowedVersions": "<1.27.0"
    },
    {
      "description": "Resolve any OPA nested-module requirement through the Go proxy",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["github.com/open-policy-agent/frameworks/constraint"],
      "enabled": true
    },
    {
      "description": "Patch the supported Go compiler line without silently raising the source compatibility floor",
      "matchDatasources": ["golang-version"],
      "allowedVersions": "<1.27.0"
    },
    {
      "matchDatasources": ["docker"],
      "pinDigests": true
    },
    {
      "description": "Helm --version takes a chart tag, not a tag@digest image reference",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/telekom/charts/auth-operator"],
      "pinDigests": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Annotated tool, embedded image and workflow-input pins outside native Dependabot manifests",
      "managerFilePatterns": [
        "/(^|/)(Makefile|versions\\.env|go\\.mod)$/",
        "/^\\.github/workflows/.*\\.ya?ml$/",
        "/^(hack|scripts|e2e|test|internal|pkg|utils)/.*\\.(sh|ya?ml|go|lock)$/"
      ],
      "matchStrings": [
        "(?:#|//) renovate: datasource=(?<datasource>go|github-releases|docker|golang-version|npm|pypi) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?\\r?\\n[^\\r\\n]*?(?<currentValue>v?\\d+\\.\\d+(?:\\.\\d+)?(?:-[0-9A-Za-z.-]+)?)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}",
      "extractVersionTemplate": "{{{extractVersion}}}"
    }
  ]
}
