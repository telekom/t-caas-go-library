# Tool versions - single source of truth for the Makefile and CI workflows.
# Keep in sync with telekom/auth-operator and telekom/k8s-breakglass.
# Go tools (golangci-lint, setup-envtest, govulncheck, go-licenses) are pinned
# in hack/tools/go.mod and hack/tools/golangci-lint/go.mod instead.

ENVTEST_K8S_VERSION=1.37.0

# dynamiccache kind E2E (e2e/dynamiccache, .github/workflows/e2e-dynamiccache.yml).
# AUTH_OPERATOR_VERSION is the chart at oci://ghcr.io/telekom/charts/auth-operator.
AUTH_OPERATOR_VERSION=0.5.0-rc.25
KIND_VERSION=v0.33.0
KUBECTL_VERSION=v1.37.2
HELM_VERSION=v4.3.1
