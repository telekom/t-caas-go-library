# Tool versions - single source of truth for the Makefile and CI workflows.
# Keep in sync with telekom/auth-operator and telekom/k8s-breakglass.

# renovate: datasource=go depName=github.com/golangci/golangci-lint/v2
GOLANGCI_LINT_VERSION=v2.12.2
# renovate: datasource=go depName=sigs.k8s.io/controller-runtime/tools/setup-envtest
ENVTEST_VERSION=v0.25.2
# renovate: datasource=github-releases depName=kubernetes-sigs/controller-tools extractVersion=^envtest-v(?<version>\d+\.\d+\.\d+)$
ENVTEST_K8S_VERSION=1.36.2
# renovate: datasource=go depName=golang.org/x/vuln
GOVULNCHECK_VERSION=v1.6.0
# renovate: datasource=go depName=github.com/google/go-licenses/v2
GO_LICENSES_VERSION=v2.0.1

# dynamiccache kind E2E (e2e/dynamiccache, .github/workflows/e2e-dynamiccache.yml).
# AUTH_OPERATOR_VERSION is the chart at oci://ghcr.io/telekom/charts/auth-operator.
# renovate: datasource=docker depName=ghcr.io/telekom/charts/auth-operator
AUTH_OPERATOR_VERSION=0.5.0-rc.12
# renovate: datasource=github-releases depName=kubernetes-sigs/kind
KIND_VERSION=v0.32.0
# renovate: datasource=github-releases depName=kubernetes/kubernetes
KUBECTL_VERSION=v1.36.4
# renovate: datasource=github-releases depName=helm/helm
HELM_VERSION=v4.2.4
